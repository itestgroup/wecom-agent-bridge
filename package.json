{
  "name": "wecom-agent-bridge",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "description": "Self-hosted WeCom messaging bridge for AI agents",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node test.mjs",
    "deploy": "python scripts/configure_worker.py --check && wrangler deploy",
