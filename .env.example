# Client environment only. This file is NOT automatically loaded by Python.
# Export these variables in your shell or use your own secret manager.
INBOX_BASE_URL=https://your-worker.example.com
INBOX_SECRET=replace-with-at-least-32-random-characters
SCF_BASE_URL=https://your-function.example.com
PUSH_SECRET=replace-with-a-separate-random-secret
# Optional. No environment-specific proxy is hardcoded.
# HTTPS_PROXY=http://proxy.example.com:3128
# KF_ALLOWED_USER_IDS=external-user-id-you-have-verified

# Optional code-only SCF deployment script (never used by CI).
# SCF_REGION=your-region
# SCF_NAMESPACE=your-test-namespace
# SCF_FUNCTION_NAME=your-test-function
# SCF_URL_QUALIFIER=$LATEST
# TENCENT_SECRET_ID=set-securely-in-your-shell
# TENCENT_SECRET_KEY=set-securely-in-your-shell
